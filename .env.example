# ---------- Neon (Postgres) ----------
# Neon dashboard -> your project -> Connection string (use the pooled one)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ---------- Shared secret (Vercel app <-> Cloudflare room server) ----------
# Make one with:  openssl rand -hex 32
# The SAME value must be set on Vercel AND on the Cloudflare worker.
GAME_SECRET=change-me-to-a-long-random-string

# ---------- Online rooms (Cloudflare Worker URL, ws/wss) ----------
# Local dev:  ws://127.0.0.1:8787     Production: wss://naija-biro-rooms.<your-subdomain>.workers.dev
GAME_WS_URL=ws://127.0.0.1:8787

# ---------- Optional ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
